#!/usr/bin/env python3
"""
Weave — Multi-runtime server manager for Knittight
"""

import argparse
import subprocess
import json
import os
import signal
import sys
from pathlib import Path

# ----------------------------
# Paths / state
# ----------------------------
WEAVE_DIR = Path.home() / ".weave"
SERVERS_FILE = WEAVE_DIR / "servers.json"
LOGS_DIR = WEAVE_DIR / "logs"

# ----------------------------
# Helpers
# ----------------------------
def ensure_dirs():
    WEAVE_DIR.mkdir(exist_ok=True)
    LOGS_DIR.mkdir(exist_ok=True)
    if not SERVERS_FILE.exists():
        SERVERS_FILE.write_text("{}")

def load_servers():
    try:
        return json.loads(SERVERS_FILE.read_text())
    except (json.JSONDecodeError, OSError):
        print("Warning: servers.json is corrupted, resetting.", file=sys.stderr)
        return {}

def save_servers(servers):
    SERVERS_FILE.write_text(json.dumps(servers, indent=2))

def is_pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, ProcessLookupError):
        return False

def detect_runtime(file):
    if file.endswith(".py"):
        return "python3"
    if file.endswith(".js"):
        return "node"
    if file.endswith(".rb"):
        return "ruby"
    if file.endswith(".go"):
        return "go"
    return None

def build_command(runtime, file, port):
    """Build the command list for subprocess.Popen"""
    if runtime == "python3":
        return ["python3", file, str(port)]
    if runtime == "node":
        return ["node", file, str(port)]
    if runtime == "ruby":
        return ["ruby", file, str(port)]
    if runtime == "go":
        return ["go", "run", file, str(port)]
    return [runtime, file, str(port)]

def check_port(port):
    if not 1 <= port <= 65535:
        print(f"Error: port must be between 1 and 65535, got {port}", file=sys.stderr)
        sys.exit(1)

def clean_stale(servers):
    """Remove entries for processes that are no longer alive. Returns cleaned dict."""
    cleaned = {}
    for name, info in servers.items():
        if is_pid_alive(info["pid"]):
            cleaned[name] = info
        else:
            print(f"Cleaning stale entry: {name} (PID {info['pid']} not running)", file=sys.stderr)
    if len(cleaned) != len(servers):
        save_servers(cleaned)
    return cleaned

def record_signal(servers):
    """Register a SIGTERM/SIGINT handler that cleans up servers.json before exit."""
    def handler(signum, frame):
        servers_copy = load_servers()
        for name, info in list(servers_copy.items()):
            if info.get("_foreground"):
                try:
                    os.kill(info["pid"], signal.SIGTERM)
                except (OSError, ProcessLookupError):
                    pass
                del servers_copy[name]
        save_servers(servers_copy)
        sys.exit(0)

    signal.signal(signal.SIGTERM, handler)
    signal.signal(signal.SIGINT, handler)

# ----------------------------
# Commands
# ----------------------------
def start_server(args):
    runtime = args.runtime or detect_runtime(args.file)
    if not runtime:
        print(f"Error: cannot detect runtime for {args.file}. Use -r to specify.", file=sys.stderr)
        sys.exit(1)

    name = args.name or f"{runtime}_{args.port}"
    check_port(args.port)

    servers = load_servers()
    if name in servers:
        print(f"Error: server '{name}' is already tracked. Stop it first or use -n.", file=sys.stderr)
        sys.exit(1)

    cmd = build_command(runtime, args.file, args.port)

    # Run the process
    if args.daemon:
        log_file = LOGS_DIR / f"{name}.log"
        with open(log_file, "w") as log:
            proc = subprocess.Popen(cmd, stdout=log, stderr=log)
    else:
        proc = subprocess.Popen(cmd)

    # Save to servers.json
    entry = {
        "pid": proc.pid,
        "runtime": runtime,
        "port": args.port,
        "file": args.file,
    }
    if not args.daemon:
        entry["_foreground"] = True

    servers[name] = entry
    save_servers(servers)

    print(f"Started {name} ({runtime}) on port {args.port} with PID {proc.pid}")

    # For foreground processes, register cleanup handler and wait
    if not args.daemon:
        record_signal(servers)
        proc.wait()

        # Process exited — clean up the entry
        servers = load_servers()
        if name in servers and servers[name].get("_foreground"):
            del servers[name]
            save_servers(servers)

def stop_server(args):
    servers = load_servers()
    target = args.target

    for name, info in list(servers.items()):
        if name == target or str(info["port"]) == target:
            try:
                os.kill(info["pid"], signal.SIGTERM)
                print(f"Stopped {name} (PID {info['pid']})")
            except ProcessLookupError:
                print(f"Process {info['pid']} not running")

            del servers[name]
            save_servers(servers)
            return

    print("Server not found.")

def restart_server(args):
    servers = load_servers()
    target = args.target
    found = None

    for name, info in servers.items():
        if name == target or str(info["port"]) == target:
            found = (name, info)
            break

    if not found:
        print("Server not found.")
        return

    name, info = found
    target_port = args.port or info["port"]

    # Stop
    try:
        os.kill(info["pid"], signal.SIGTERM)
    except (OSError, ProcessLookupError):
        pass

    # Start
    runtime = info["runtime"]
    file = info["file"]
    cmd = build_command(runtime, file, target_port)

    if args.daemon:
        log_file = LOGS_DIR / f"{name}.log"
        with open(log_file, "w") as log:
            proc = subprocess.Popen(cmd, stdout=log, stderr=log)
    else:
        proc = subprocess.Popen(cmd)

    servers[name] = {
        "pid": proc.pid,
        "runtime": runtime,
        "port": target_port,
        "file": file,
    }
    save_servers(servers)

    print(f"Restarted {name} ({runtime}) on port {target_port} with PID {proc.pid}")

    if not args.daemon:
        servers[name]["_foreground"] = True
        save_servers(servers)
        record_signal(servers)
        proc.wait()
        servers = load_servers()
        if name in servers and servers[name].get("_foreground"):
            del servers[name]
            save_servers(servers)

def status_servers(_args):
    servers = load_servers()
    if not servers:
        print("No servers running.")
        return

    servers = clean_stale(servers)
    if not servers:
        print("No servers running.")
        return

    print(f"{'NAME':<20}{'RUNTIME':<10}{'PORT':<6}{'PID':<8}{'STATUS':<10}")
    for name, info in servers.items():
        alive = is_pid_alive(info["pid"])
        status = "running" if alive else "dead"
        print(f"{name:<20}{info['runtime']:<10}{info['port']:<6}{info['pid']:<8}{status:<10}")

def list_runtimes(_args):
    print("Supported runtimes:")
    print("  python3  (.py)")
    print("  node     (.js)")
    print("  ruby     (.rb)")
    print("  go       (.go)")

def create_preset(args):
    path = Path(args.file)
    if path.exists():
        print(f"Error: {path} already exists.")
        return

    templates = {
        "python": """#!/usr/bin/env python3
from http.server import HTTPServer, SimpleHTTPRequestHandler
import sys

PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 8000

with HTTPServer(('0.0.0.0', PORT), SimpleHTTPRequestHandler) as server:
    print(f"Serving on port {PORT}")
    server.serve_forever()
""",
        "node": """const express = require('express');
const app = express();
const PORT = process.argv[2] || 8000;

app.get('/', (req, res) => {
    res.send('Hello from Node.js server!');
});

app.listen(PORT, () => {
    console.log(`Server running on port ${PORT}`);
});
""",
        "ruby": """require 'webrick'

port = ARGV[0] ? ARGV[0].to_i : 8000
server = WEBrick::HTTPServer.new(Port: port, DocumentRoot: Dir.pwd)

trap('INT') { server.shutdown }
puts "Server running on port #{port}"
server.start
""",
        "go": """package main

import (
    "fmt"
    "net/http"
    "os"
)

func main() {
    port := "8000"
    if len(os.Args) > 1 {
        port = os.Args[1]
    }
    fmt.Println("Server running on port", port)
    http.ListenAndServe(":" + port, http.FileServer(http.Dir(".")))
}
"""
    }

    path.write_text(templates[args.runtime])
    path.chmod(0o755)
    print(f"{args.runtime} preset created at {path}")

# ----------------------------
# CLI
# ----------------------------
def main():
    ensure_dirs()

    parser = argparse.ArgumentParser(
        description="Weave — multi-runtime server manager"
    )
    sub = parser.add_subparsers(dest="command", required=True)

    # start
    start = sub.add_parser("start")
    start.add_argument("-r", "--runtime", help="Runtime (python3, node, ruby, go). Auto-detected from file extension if omitted.")
    start.add_argument("-p", "--port", type=int, default=8000)
    start.add_argument("-F", "--file", required=True)
    start.add_argument("-n", "--name", help="Server name")
    start.add_argument("-d", "--daemon", action="store_true")
    start.set_defaults(func=start_server)

    # stop
    stop = sub.add_parser("stop")
    stop.add_argument("target", help="Server name or port")
    stop.set_defaults(func=stop_server)

    # restart
    restart = sub.add_parser("restart")
    restart.add_argument("target", help="Server name or port")
    restart.add_argument("-p", "--port", type=int, help="New port (optional)")
    restart.add_argument("-d", "--daemon", action="store_true")
    restart.set_defaults(func=restart_server)

    # status
    status = sub.add_parser("status")
    status.set_defaults(func=status_servers)

    # list
    lst = sub.add_parser("list")
    lst.set_defaults(func=list_runtimes)

    # pres (preset)
    pres = sub.add_parser("pres", help="Create a server preset for a runtime")
    pres.add_argument("-r", "--runtime", choices=["python", "node", "ruby", "go"], required=True, help="Runtime type")
    pres.add_argument("file", help="File to create")
    pres.set_defaults(func=create_preset)

    args = parser.parse_args()
    args.func(args)

if __name__ == "__main__":
    main()
